 294:Core/Src/vl53l1_core_support.c **** uint16_t VL53L1_rate_per_spad_maths(
 295:Core/Src/vl53l1_core_support.c **** 	uint32_t  frac_bits,
 296:Core/Src/vl53l1_core_support.c **** 	uint32_t  peak_count_rate,
 297:Core/Src/vl53l1_core_support.c **** 	uint16_t  num_spads,
 298:Core/Src/vl53l1_core_support.c **** 	uint32_t  max_output_value)
 299:Core/Src/vl53l1_core_support.c **** {
 300:Core/Src/vl53l1_core_support.c **** 
 301:Core/Src/vl53l1_core_support.c **** 	uint32_t  tmp_int   = 0;
 302:Core/Src/vl53l1_core_support.c **** 
 303:Core/Src/vl53l1_core_support.c **** 	/* rate_per_spad Format varies with prog frac_bits */
 304:Core/Src/vl53l1_core_support.c **** 	uint16_t  rate_per_spad = 0;
 305:Core/Src/vl53l1_core_support.c **** 
 306:Core/Src/vl53l1_core_support.c **** 	/* Calculate rate per spad with variable fractional bits */
 307:Core/Src/vl53l1_core_support.c **** 
 308:Core/Src/vl53l1_core_support.c **** 	/* Frac_bits should be programmed as final frac_bits - 7 as
 309:Core/Src/vl53l1_core_support.c **** 	 * the pk_rate contains an inherent 7 bit resolution
 310:Core/Src/vl53l1_core_support.c **** 	 */
 311:Core/Src/vl53l1_core_support.c **** 
 312:Core/Src/vl53l1_core_support.c **** 	if (num_spads > 0) {
 313:Core/Src/vl53l1_core_support.c **** 		tmp_int = (peak_count_rate << 8) << frac_bits;
 314:Core/Src/vl53l1_core_support.c **** 		tmp_int = (tmp_int + ((uint32_t)num_spads / 2)) / (uint32_t)num_spads;
 315:Core/Src/vl53l1_core_support.c **** 	} else {
 316:Core/Src/vl53l1_core_support.c **** 		tmp_int = ((peak_count_rate) << frac_bits);
 317:Core/Src/vl53l1_core_support.c **** 	}
 318:Core/Src/vl53l1_core_support.c **** 
 319:Core/Src/vl53l1_core_support.c **** 	/* Clip in case of overwrap - special code */
 320:Core/Src/vl53l1_core_support.c **** 
 321:Core/Src/vl53l1_core_support.c **** 	if (tmp_int > max_output_value) {
 322:Core/Src/vl53l1_core_support.c **** 		tmp_int = max_output_value;
 323:Core/Src/vl53l1_core_support.c **** 	}
 324:Core/Src/vl53l1_core_support.c **** 
 325:Core/Src/vl53l1_core_support.c **** 	rate_per_spad = (uint16_t)tmp_int;
 326:Core/Src/vl53l1_core_support.c **** 
 327:Core/Src/vl53l1_core_support.c **** 	return rate_per_spad;
 328:Core/Src/vl53l1_core_support.c **** }
