 330:Core/Src/vl53l1_core_support.c **** int32_t VL53L1_range_maths(
 331:Core/Src/vl53l1_core_support.c **** 	uint16_t  fast_osc_frequency,
 332:Core/Src/vl53l1_core_support.c **** 	uint16_t  phase,
 333:Core/Src/vl53l1_core_support.c **** 	uint16_t  zero_distance_phase,
 334:Core/Src/vl53l1_core_support.c **** 	uint8_t   fractional_bits,
 335:Core/Src/vl53l1_core_support.c **** 	int32_t   gain_factor,
 336:Core/Src/vl53l1_core_support.c **** 	int32_t   range_offset_mm)
 337:Core/Src/vl53l1_core_support.c **** {
 338:Core/Src/vl53l1_core_support.c **** 	/*
 339:Core/Src/vl53l1_core_support.c **** 	 * Converts phase information into distance in [mm]
 340:Core/Src/vl53l1_core_support.c **** 	 */
 341:Core/Src/vl53l1_core_support.c **** 
 342:Core/Src/vl53l1_core_support.c **** 	uint32_t    pll_period_us = 0; /* 0.24 format */
 343:Core/Src/vl53l1_core_support.c **** 	int64_t     tmp_long_int  = 0;
 344:Core/Src/vl53l1_core_support.c **** 	int32_t     range_mm      = 0;
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccN38dOa.s 			page 8


 345:Core/Src/vl53l1_core_support.c **** 
 346:Core/Src/vl53l1_core_support.c **** 	/* Calculate PLL period in [ps] */
 347:Core/Src/vl53l1_core_support.c **** 
 348:Core/Src/vl53l1_core_support.c **** 	pll_period_us  = VL53L1_calc_pll_period_us(fast_osc_frequency);
 349:Core/Src/vl53l1_core_support.c **** 
 350:Core/Src/vl53l1_core_support.c **** 	/* Raw range in [mm]
 351:Core/Src/vl53l1_core_support.c **** 	 *
 352:Core/Src/vl53l1_core_support.c **** 	 * calculate the phase difference between return and reference phases
 353:Core/Src/vl53l1_core_support.c **** 	 *
 354:Core/Src/vl53l1_core_support.c **** 	 * phases 16b (5.11)
 355:Core/Src/vl53l1_core_support.c **** 	 * output 17b including sign bit
 356:Core/Src/vl53l1_core_support.c **** 	 */
 357:Core/Src/vl53l1_core_support.c **** 
 358:Core/Src/vl53l1_core_support.c **** 	tmp_long_int = (int64_t)phase - (int64_t)zero_distance_phase;
 359:Core/Src/vl53l1_core_support.c **** 
 360:Core/Src/vl53l1_core_support.c **** 	/*
 361:Core/Src/vl53l1_core_support.c **** 	 * multiply by the PLL period
 362:Core/Src/vl53l1_core_support.c **** 	 *
 363:Core/Src/vl53l1_core_support.c **** 	 * PLL period 24bit (0.24) but only 18 LS bits used
 364:Core/Src/vl53l1_core_support.c **** 	 *
 365:Core/Src/vl53l1_core_support.c **** 	 * Output  35b (0.35) (17b + 18b)
 366:Core/Src/vl53l1_core_support.c **** 	 */
 367:Core/Src/vl53l1_core_support.c **** 
 368:Core/Src/vl53l1_core_support.c **** 	tmp_long_int =  tmp_long_int * (int64_t)pll_period_us;
 369:Core/Src/vl53l1_core_support.c **** 
 370:Core/Src/vl53l1_core_support.c **** 	/*
 371:Core/Src/vl53l1_core_support.c **** 	 * Down shift by 9 - Output 26b (0.26)
 372:Core/Src/vl53l1_core_support.c **** 	 */
 373:Core/Src/vl53l1_core_support.c **** 
 374:Core/Src/vl53l1_core_support.c **** 	tmp_long_int =  tmp_long_int / (0x01 << 9);
 375:Core/Src/vl53l1_core_support.c **** 
 376:Core/Src/vl53l1_core_support.c **** 	/*
 377:Core/Src/vl53l1_core_support.c **** 	 *  multiply by speed of light in air divided by 8
 378:Core/Src/vl53l1_core_support.c **** 	 *  Factor of 8 includes 2 for the round trip and 4 scaling
 379:Core/Src/vl53l1_core_support.c **** 	 *
 380:Core/Src/vl53l1_core_support.c **** 	 *  VL53L1_SPEED_OF_LIGHT_IN_AIR_DIV_8 = 16b (16.2)
 381:Core/Src/vl53l1_core_support.c **** 	 *
 382:Core/Src/vl53l1_core_support.c **** 	 *  Output 42b (18.24) (16b + 26b)
 383:Core/Src/vl53l1_core_support.c **** 	 */
 384:Core/Src/vl53l1_core_support.c **** 
 385:Core/Src/vl53l1_core_support.c **** 	tmp_long_int =  tmp_long_int * VL53L1_SPEED_OF_LIGHT_IN_AIR_DIV_8;
 386:Core/Src/vl53l1_core_support.c **** 
 387:Core/Src/vl53l1_core_support.c **** 	/*
 388:Core/Src/vl53l1_core_support.c **** 	 * Down shift by 22 - Output 20b (18.2)
 389:Core/Src/vl53l1_core_support.c **** 	 */
 390:Core/Src/vl53l1_core_support.c **** 
 391:Core/Src/vl53l1_core_support.c **** 	tmp_long_int =  tmp_long_int / (0x01 << 22);
 392:Core/Src/vl53l1_core_support.c **** 
 393:Core/Src/vl53l1_core_support.c **** 	/* Add range offset */
 394:Core/Src/vl53l1_core_support.c **** 	range_mm  = (int32_t)tmp_long_int + range_offset_mm;
 395:Core/Src/vl53l1_core_support.c **** 
 396:Core/Src/vl53l1_core_support.c **** 	/* apply correction gain */
 397:Core/Src/vl53l1_core_support.c **** 	range_mm *= gain_factor;
 398:Core/Src/vl53l1_core_support.c **** 	range_mm += 0x0400;
 399:Core/Src/vl53l1_core_support.c **** 	range_mm /= 0x0800;
 400:Core/Src/vl53l1_core_support.c **** 
 401:Core/Src/vl53l1_core_support.c **** 	/* Remove fractional bits */
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccN38dOa.s 			page 9


 402:Core/Src/vl53l1_core_support.c **** 	if (fractional_bits == 0)
 403:Core/Src/vl53l1_core_support.c **** 		range_mm = range_mm / (0x01 << 2);
 404:Core/Src/vl53l1_core_support.c **** 	else if (fractional_bits == 1)
 405:Core/Src/vl53l1_core_support.c **** 		range_mm = range_mm / (0x01 << 1);
 406:Core/Src/vl53l1_core_support.c **** 
 407:Core/Src/vl53l1_core_support.c **** 	return range_mm;
 408:Core/Src/vl53l1_core_support.c **** }
 409:Core/Src/vl53l1_core_support.c **** #endif
