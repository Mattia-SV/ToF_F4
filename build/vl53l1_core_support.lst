  94:Core/Src/vl53l1_core_support.c **** uint32_t VL53L1_calc_pll_period_us(
  95:Core/Src/vl53l1_core_support.c **** 	uint16_t  fast_osc_frequency)
  96:Core/Src/vl53l1_core_support.c **** {
  30              		.loc 1 96 1 view -0
  31              		.cfi_startproc
  32              		@ args = 0, pretend = 0, frame = 0
  33              		@ frame_needed = 0, uses_anonymous_args = 0
  34              		@ link register save eliminated.
  97:Core/Src/vl53l1_core_support.c **** 	/*  Calculates PLL frequency using NVM fast_osc_frequency
  98:Core/Src/vl53l1_core_support.c **** 	 *  Fast osc frequency fixed point format = unsigned 4.12
  99:Core/Src/vl53l1_core_support.c **** 	 *
 100:Core/Src/vl53l1_core_support.c **** 	 *  PLL period fixed point format = unsigned 0.24
 101:Core/Src/vl53l1_core_support.c **** 	 *  Min input fast osc frequency  = 1 MHz
 102:Core/Src/vl53l1_core_support.c **** 	 *  PLL Multiplier = 64 (fixed)
 103:Core/Src/vl53l1_core_support.c **** 	 *  Min PLL freq = 64.0MHz
 104:Core/Src/vl53l1_core_support.c **** 	 *  -> max PLL period = 1/ 64
 105:Core/Src/vl53l1_core_support.c **** 	 *  ->  only the 18 LS bits are used
 106:Core/Src/vl53l1_core_support.c **** 	 *
 107:Core/Src/vl53l1_core_support.c **** 	 *  2^30 = (2^24) (1.0us) * 4096 (2^12) / 64 (PLL Multiplier)
 108:Core/Src/vl53l1_core_support.c **** 	 */
 109:Core/Src/vl53l1_core_support.c **** 
 110:Core/Src/vl53l1_core_support.c **** 	uint32_t  pll_period_us        = 0;
  35              		.loc 1 110 2 view .LVU1
 111:Core/Src/vl53l1_core_support.c **** 
 112:Core/Src/vl53l1_core_support.c **** 	LOG_FUNCTION_START("");
  36              		.loc 1 112 24 view .LVU2
 113:Core/Src/vl53l1_core_support.c **** 
 114:Core/Src/vl53l1_core_support.c **** 	pll_period_us = (0x01 << 30) / fast_osc_frequency;
  37              		.loc 1 114 2 view .LVU3
 115:Core/Src/vl53l1_core_support.c **** 
 116:Core/Src/vl53l1_core_support.c **** #ifdef VL53L1_LOGGING
 117:Core/Src/vl53l1_core_support.c **** 	trace_print(VL53L1_TRACE_LEVEL_DEBUG,
 118:Core/Src/vl53l1_core_support.c **** 			"    %-48s : %10u\n", "pll_period_us",
 119:Core/Src/vl53l1_core_support.c **** 			pll_period_us);
 120:Core/Src/vl53l1_core_support.c **** #endif
 121:Core/Src/vl53l1_core_support.c **** 
 122:Core/Src/vl53l1_core_support.c **** 	LOG_FUNCTION_END(0);
  38              		.loc 1 122 21 view .LVU4
 123:Core/Src/vl53l1_core_support.c **** 
 124:Core/Src/vl53l1_core_support.c **** 	return pll_period_us;
  39              		.loc 1 124 2 view .LVU5
 125:Core/Src/vl53l1_core_support.c **** }
