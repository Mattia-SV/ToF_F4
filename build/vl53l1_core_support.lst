 126:Core/Src/vl53l1_core_support.c **** 
 127:Core/Src/vl53l1_core_support.c **** 
 128:Core/Src/vl53l1_core_support.c **** #ifdef PAL_EXTENDED
 129:Core/Src/vl53l1_core_support.c **** uint32_t  VL53L1_duration_maths(
 130:Core/Src/vl53l1_core_support.c **** 	uint32_t  pll_period_us,
 131:Core/Src/vl53l1_core_support.c **** 	uint32_t  vcsel_parm_pclks,
 132:Core/Src/vl53l1_core_support.c **** 	uint32_t  window_vclks,
 133:Core/Src/vl53l1_core_support.c **** 	uint32_t  elapsed_mclks)
 134:Core/Src/vl53l1_core_support.c **** {
 135:Core/Src/vl53l1_core_support.c **** 	/*
 136:Core/Src/vl53l1_core_support.c **** 	 * Generates the ranging duration in us
 137:Core/Src/vl53l1_core_support.c **** 	 *
 138:Core/Src/vl53l1_core_support.c **** 	 * duration_us = elapsed_mclks * vcsel_perm_pclks *
 139:Core/Src/vl53l1_core_support.c **** 	 *                        window_vclks * pll_period_us
 140:Core/Src/vl53l1_core_support.c **** 	 *
 141:Core/Src/vl53l1_core_support.c **** 	 * returned value in [us] with no fraction bits
 142:Core/Src/vl53l1_core_support.c **** 	 */
 143:Core/Src/vl53l1_core_support.c **** 
 144:Core/Src/vl53l1_core_support.c **** 	uint64_t  tmp_long_int = 0;
 145:Core/Src/vl53l1_core_support.c **** 	uint32_t  duration_us  = 0;
 146:Core/Src/vl53l1_core_support.c **** 
 147:Core/Src/vl53l1_core_support.c **** 	/* PLL period us =  0.24  18 LS bits used
 148:Core/Src/vl53l1_core_support.c **** 	 * window_vclks  =  12.0  (2304 max)
 149:Core/Src/vl53l1_core_support.c **** 	 * output 30b (6.24)
 150:Core/Src/vl53l1_core_support.c **** 	 */
 151:Core/Src/vl53l1_core_support.c **** 	duration_us = window_vclks * pll_period_us;
 152:Core/Src/vl53l1_core_support.c **** 
 153:Core/Src/vl53l1_core_support.c **** 	/* down shift by 12
 154:Core/Src/vl53l1_core_support.c **** 	 * output 18b (6.12)
 155:Core/Src/vl53l1_core_support.c **** 	 */
 156:Core/Src/vl53l1_core_support.c **** 	duration_us = duration_us >> 12;
 157:Core/Src/vl53l1_core_support.c **** 
 158:Core/Src/vl53l1_core_support.c **** 	/* Save first part of the calc (#1) */
 159:Core/Src/vl53l1_core_support.c **** 	tmp_long_int = (uint64_t)duration_us;
 160:Core/Src/vl53l1_core_support.c **** 
 161:Core/Src/vl53l1_core_support.c **** 	/* Multiply elapsed macro periods (22-bit)
 162:Core/Src/vl53l1_core_support.c **** 	 *      by VCSEL parameter 6.4  (max 63.9999)
 163:Core/Src/vl53l1_core_support.c **** 	 * output 32b (28.4)
 164:Core/Src/vl53l1_core_support.c **** 	 */
 165:Core/Src/vl53l1_core_support.c **** 	duration_us = elapsed_mclks * vcsel_parm_pclks;
 166:Core/Src/vl53l1_core_support.c **** 
 167:Core/Src/vl53l1_core_support.c **** 	/* down shift by 4 to remove fractional bits (#2)
 168:Core/Src/vl53l1_core_support.c **** 	 * output 28b (28.0)
 169:Core/Src/vl53l1_core_support.c **** 	 */
 170:Core/Src/vl53l1_core_support.c **** 	duration_us = duration_us >> 4;
 171:Core/Src/vl53l1_core_support.c **** 
 172:Core/Src/vl53l1_core_support.c **** 	/* Multiply #1 18b (6.12) by #2  28b (28.0)
 173:Core/Src/vl53l1_core_support.c **** 	 * output 46b (34.12)
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccN38dOa.s 			page 5


 174:Core/Src/vl53l1_core_support.c **** 	 */
 175:Core/Src/vl53l1_core_support.c **** 	tmp_long_int = tmp_long_int * (uint64_t)duration_us;
 176:Core/Src/vl53l1_core_support.c **** 
 177:Core/Src/vl53l1_core_support.c **** 	/* Remove fractional part
 178:Core/Src/vl53l1_core_support.c **** 	 * output 34b (34.0)
 179:Core/Src/vl53l1_core_support.c **** 	 */
 180:Core/Src/vl53l1_core_support.c **** 	tmp_long_int = tmp_long_int >> 12;
 181:Core/Src/vl53l1_core_support.c **** 
 182:Core/Src/vl53l1_core_support.c **** 	/* Clip to 32-bits */
 183:Core/Src/vl53l1_core_support.c **** 	if (tmp_long_int > 0xFFFFFFFF) {
 184:Core/Src/vl53l1_core_support.c **** 		tmp_long_int = 0xFFFFFFFF;
 185:Core/Src/vl53l1_core_support.c **** 	}
 186:Core/Src/vl53l1_core_support.c **** 
 187:Core/Src/vl53l1_core_support.c **** 	duration_us  = (uint32_t)tmp_long_int;
 188:Core/Src/vl53l1_core_support.c **** 
 189:Core/Src/vl53l1_core_support.c **** 	return duration_us;
 190:Core/Src/vl53l1_core_support.c **** }
 191:Core/Src/vl53l1_core_support.c **** 
 192:Core/Src/vl53l1_core_support.c **** 
 193:Core/Src/vl53l1_core_support.c **** uint32_t VL53L1_isqrt(uint32_t num)
 194:Core/Src/vl53l1_core_support.c **** {
 195:Core/Src/vl53l1_core_support.c **** 
 196:Core/Src/vl53l1_core_support.c **** 	/*
 197:Core/Src/vl53l1_core_support.c **** 	 * Implements an integer square root
 198:Core/Src/vl53l1_core_support.c **** 	 *
 199:Core/Src/vl53l1_core_support.c **** 	 * From: http://en.wikipedia.org/wiki/Methods_of_computing_square_roots
 200:Core/Src/vl53l1_core_support.c **** 	 */
 201:Core/Src/vl53l1_core_support.c **** 
 202:Core/Src/vl53l1_core_support.c **** 	uint32_t  res = 0;
 203:Core/Src/vl53l1_core_support.c **** 	uint32_t  bit = 1 << 30; /* The second-to-top bit is set: 1 << 14 for 16-bits, 1 << 30 for 32 bits
 204:Core/Src/vl53l1_core_support.c **** 
 205:Core/Src/vl53l1_core_support.c **** 	/* "bit" starts at the highest power of four <= the argument. */
 206:Core/Src/vl53l1_core_support.c **** 	while (bit > num) {
 207:Core/Src/vl53l1_core_support.c **** 		bit >>= 2;
 208:Core/Src/vl53l1_core_support.c **** 	}
 209:Core/Src/vl53l1_core_support.c **** 
 210:Core/Src/vl53l1_core_support.c **** 	while (bit != 0) {
 211:Core/Src/vl53l1_core_support.c **** 		if (num >= res + bit)  {
 212:Core/Src/vl53l1_core_support.c **** 			num -= res + bit;
 213:Core/Src/vl53l1_core_support.c **** 			res = (res >> 1) + bit;
 214:Core/Src/vl53l1_core_support.c **** 		} else {
 215:Core/Src/vl53l1_core_support.c **** 			res >>= 1;
 216:Core/Src/vl53l1_core_support.c **** 		}
 217:Core/Src/vl53l1_core_support.c **** 		bit >>= 2;
 218:Core/Src/vl53l1_core_support.c **** 	}
 219:Core/Src/vl53l1_core_support.c **** 
 220:Core/Src/vl53l1_core_support.c **** 	return res;
 221:Core/Src/vl53l1_core_support.c **** }
 222:Core/Src/vl53l1_core_support.c **** 
 223:Core/Src/vl53l1_core_support.c **** 
 224:Core/Src/vl53l1_core_support.c **** uint16_t VL53L1_rate_maths(
 225:Core/Src/vl53l1_core_support.c **** 	int32_t   events,
 226:Core/Src/vl53l1_core_support.c **** 	uint32_t  time_us)
 227:Core/Src/vl53l1_core_support.c **** {
 228:Core/Src/vl53l1_core_support.c **** 	/*
 229:Core/Src/vl53l1_core_support.c **** 	 * Converts events into count rate
 230:Core/Src/vl53l1_core_support.c **** 	 *
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccN38dOa.s 			page 6


 231:Core/Src/vl53l1_core_support.c **** 	 * Max events = 512 Mcps * 1sec
 232:Core/Src/vl53l1_core_support.c **** 	 *            = 512,000,000 events
 233:Core/Src/vl53l1_core_support.c **** 	 *            = 29b
 234:Core/Src/vl53l1_core_support.c **** 	 *
 235:Core/Src/vl53l1_core_support.c **** 	 * If events >  2^24 use  3-bit fractional bits is used internally
 236:Core/Src/vl53l1_core_support.c **** 	 * otherwise  7-bit fractional bits are used
 237:Core/Src/vl53l1_core_support.c **** 	 */
 238:Core/Src/vl53l1_core_support.c **** 
 239:Core/Src/vl53l1_core_support.c **** 	uint32_t  tmp_int   = 0;
 240:Core/Src/vl53l1_core_support.c **** 	uint32_t  frac_bits = 7;
 241:Core/Src/vl53l1_core_support.c **** 	uint16_t  rate_mcps = 0; /* 9.7 format */
 242:Core/Src/vl53l1_core_support.c **** 
 243:Core/Src/vl53l1_core_support.c **** 	/*
 244:Core/Src/vl53l1_core_support.c **** 	 *  Clip input event range
 245:Core/Src/vl53l1_core_support.c **** 	 */
 246:Core/Src/vl53l1_core_support.c **** 
 247:Core/Src/vl53l1_core_support.c **** 	if (events > VL53L1_SPAD_TOTAL_COUNT_MAX) {
 248:Core/Src/vl53l1_core_support.c **** 		tmp_int = VL53L1_SPAD_TOTAL_COUNT_MAX;
 249:Core/Src/vl53l1_core_support.c **** 	} else if (events > 0) {
 250:Core/Src/vl53l1_core_support.c **** 		tmp_int = (uint32_t)events;
 251:Core/Src/vl53l1_core_support.c **** 	}
 252:Core/Src/vl53l1_core_support.c **** 
 253:Core/Src/vl53l1_core_support.c **** 	/*
 254:Core/Src/vl53l1_core_support.c **** 	 * if events > VL53L1_SPAD_TOTAL_COUNT_RES_THRES use 3 rather
 255:Core/Src/vl53l1_core_support.c **** 	 *  than 7 fractional bits internal to function
 256:Core/Src/vl53l1_core_support.c **** 	 */
 257:Core/Src/vl53l1_core_support.c **** 
 258:Core/Src/vl53l1_core_support.c **** 	if (events > VL53L1_SPAD_TOTAL_COUNT_RES_THRES) {
 259:Core/Src/vl53l1_core_support.c **** 		frac_bits = 3;
 260:Core/Src/vl53l1_core_support.c **** 	} else {
 261:Core/Src/vl53l1_core_support.c **** 		frac_bits = 7;
 262:Core/Src/vl53l1_core_support.c **** 	}
 263:Core/Src/vl53l1_core_support.c **** 
 264:Core/Src/vl53l1_core_support.c **** 	/*
 265:Core/Src/vl53l1_core_support.c **** 	 * Create 3 or 7 fractional bits
 266:Core/Src/vl53l1_core_support.c **** 	 * output 32b (29.3 or 25.7)
 267:Core/Src/vl53l1_core_support.c **** 	 * Divide by range duration in [us] - no fractional bits
 268:Core/Src/vl53l1_core_support.c **** 	 */
 269:Core/Src/vl53l1_core_support.c **** 	if (time_us > 0) {
 270:Core/Src/vl53l1_core_support.c **** 		tmp_int = ((tmp_int << frac_bits) + (time_us / 2)) / time_us;
 271:Core/Src/vl53l1_core_support.c **** 	}
 272:Core/Src/vl53l1_core_support.c **** 
 273:Core/Src/vl53l1_core_support.c **** 	/*
 274:Core/Src/vl53l1_core_support.c **** 	 * Re align if reduced resolution
 275:Core/Src/vl53l1_core_support.c **** 	 */
 276:Core/Src/vl53l1_core_support.c **** 	if (events > VL53L1_SPAD_TOTAL_COUNT_RES_THRES) {
 277:Core/Src/vl53l1_core_support.c **** 		tmp_int = tmp_int << 4;
 278:Core/Src/vl53l1_core_support.c **** 	}
 279:Core/Src/vl53l1_core_support.c **** 
 280:Core/Src/vl53l1_core_support.c **** 	/*
 281:Core/Src/vl53l1_core_support.c **** 	 * Firmware internal count is 17.7 (24b) but it this
 282:Core/Src/vl53l1_core_support.c **** 	 * case clip to 16-bit value for reporting
 283:Core/Src/vl53l1_core_support.c **** 	 */
 284:Core/Src/vl53l1_core_support.c **** 
 285:Core/Src/vl53l1_core_support.c **** 	if (tmp_int > 0xFFFF) {
 286:Core/Src/vl53l1_core_support.c **** 		tmp_int = 0xFFFF;
 287:Core/Src/vl53l1_core_support.c **** 	}
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccN38dOa.s 			page 7


 288:Core/Src/vl53l1_core_support.c **** 
 289:Core/Src/vl53l1_core_support.c **** 	rate_mcps =  (uint16_t)tmp_int;
 290:Core/Src/vl53l1_core_support.c **** 
 291:Core/Src/vl53l1_core_support.c **** 	return rate_mcps;
 292:Core/Src/vl53l1_core_support.c **** }
