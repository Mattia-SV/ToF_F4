 343:Core/Src/vl53l1_api.c **** 
 344:Core/Src/vl53l1_api.c **** 
 345:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_START("");
 346:Core/Src/vl53l1_api.c **** 
 347:Core/Src/vl53l1_api.c **** 	/* check if the following are selected
 348:Core/Src/vl53l1_api.c **** 	 * VL53L1_PRESETMODE_AUTONOMOUS,
 349:Core/Src/vl53l1_api.c **** 	 * VL53L1_PRESETMODE_LOWPOWER_AUTONOMOUS
 350:Core/Src/vl53l1_api.c **** 	 * VL53L1_PRESETMODE_LITE_RANGING
 351:Core/Src/vl53l1_api.c **** 	 */
 352:Core/Src/vl53l1_api.c **** 	PresetMode = VL53L1DevDataGet(Dev, CurrentParameters.PresetMode);
 353:Core/Src/vl53l1_api.c **** 
 354:Core/Src/vl53l1_api.c **** 	if ((PresetMode != VL53L1_PRESETMODE_AUTONOMOUS) &&
 355:Core/Src/vl53l1_api.c **** 		(PresetMode != VL53L1_PRESETMODE_LOWPOWER_AUTONOMOUS) &&
 356:Core/Src/vl53l1_api.c **** 		(PresetMode != VL53L1_PRESETMODE_LITE_RANGING)) {
 357:Core/Src/vl53l1_api.c **** 		Status = VL53L1_ERROR_MODE_NOT_SUPPORTED;
 358:Core/Src/vl53l1_api.c **** 		goto ENDFUNC;
 359:Core/Src/vl53l1_api.c **** 	}
 360:Core/Src/vl53l1_api.c **** 
 361:Core/Src/vl53l1_api.c **** 	/* disable crosstalk calibration */
 362:Core/Src/vl53l1_api.c **** 	Status = VL53L1_disable_xtalk_compensation(Dev);
 363:Core/Src/vl53l1_api.c **** 
 364:Core/Src/vl53l1_api.c **** 	if (Status != VL53L1_ERROR_NONE)
 365:Core/Src/vl53l1_api.c **** 		goto ENDFUNC;
 366:Core/Src/vl53l1_api.c **** 
