 374:Core/Src/vl53l1_api.c **** 	VL53L1_GetRangingMeasurementData(Dev, &RMData);
 375:Core/Src/vl53l1_api.c **** 	VL53L1_ClearInterruptAndStartMeasurement(Dev);
 376:Core/Src/vl53l1_api.c **** 
 377:Core/Src/vl53l1_api.c **** 	sum_ranging = 0;
 378:Core/Src/vl53l1_api.c **** 	sum_spads = 0;
 379:Core/Src/vl53l1_api.c **** 	sum_signalRate = 0;
 380:Core/Src/vl53l1_api.c **** 	total_count = 0;
 381:Core/Src/vl53l1_api.c **** 	for (xtalk_meas = 0; xtalk_meas < xtalk_measmax; xtalk_meas++) {
 382:Core/Src/vl53l1_api.c **** 		VL53L1_WaitMeasurementDataReady(Dev);
 383:Core/Src/vl53l1_api.c **** 		VL53L1_GetRangingMeasurementData(Dev, &RMData);
 384:Core/Src/vl53l1_api.c **** 		VL53L1_ClearInterruptAndStartMeasurement(Dev);
 385:Core/Src/vl53l1_api.c **** 		if (RMData.RangeStatus == VL53L1_RANGESTATUS_RANGE_VALID) {
 386:Core/Src/vl53l1_api.c **** 			sum_ranging += RMData.RangeMilliMeter;
 387:Core/Src/vl53l1_api.c **** 			sum_signalRate += RMData.SignalRateRtnMegaCps;
 388:Core/Src/vl53l1_api.c **** 			sum_spads += RMData.EffectiveSpadRtnCount / 256;
 389:Core/Src/vl53l1_api.c **** 			total_count++;
 390:Core/Src/vl53l1_api.c **** 		}
 391:Core/Src/vl53l1_api.c **** 	}
 392:Core/Src/vl53l1_api.c **** 	Status = VL53L1_StopMeasurement(Dev);
 393:Core/Src/vl53l1_api.c **** 
 394:Core/Src/vl53l1_api.c **** 	if (total_count > 0) {
 395:Core/Src/vl53l1_api.c **** 		/* FixPoint1616_t / uint16_t = FixPoint1616_t */
 396:Core/Src/vl53l1_api.c **** 		xTalkStoredMeanSignalRate = sum_signalRate / total_count;
 397:Core/Src/vl53l1_api.c **** 		xTalkStoredMeanRange = (FixPoint1616_t)(sum_ranging << 16);
 398:Core/Src/vl53l1_api.c **** 		xTalkStoredMeanRange /= total_count;
 399:Core/Src/vl53l1_api.c **** 		xTalkStoredMeanRtnSpads = (FixPoint1616_t)(sum_spads << 16);
 400:Core/Src/vl53l1_api.c **** 		xTalkStoredMeanRtnSpads /= total_count;
 401:Core/Src/vl53l1_api.c **** 
 402:Core/Src/vl53l1_api.c **** 		/* Round Mean Spads to Whole Number.
 403:Core/Src/vl53l1_api.c **** 		 * Typically the calculated mean SPAD count is a whole number
 404:Core/Src/vl53l1_api.c **** 		 * or very close to a whole
 405:Core/Src/vl53l1_api.c **** 		 * number, therefore any truncation will not result in a
 406:Core/Src/vl53l1_api.c **** 		 * significant loss in accuracy.
 407:Core/Src/vl53l1_api.c **** 		 * Also, for a grey target at a typical distance of around
 408:Core/Src/vl53l1_api.c **** 		 * 400mm, around 220 SPADs will
 409:Core/Src/vl53l1_api.c **** 		 * be enabled, therefore, any truncation will result in a loss
 410:Core/Src/vl53l1_api.c **** 		 * of accuracy of less than
 411:Core/Src/vl53l1_api.c **** 		 * 0.5%.
 412:Core/Src/vl53l1_api.c **** 		 */
 413:Core/Src/vl53l1_api.c **** 		xTalkStoredMeanRtnSpadsAsInt = (xTalkStoredMeanRtnSpads +
 414:Core/Src/vl53l1_api.c **** 			0x8000) >> 16;
 415:Core/Src/vl53l1_api.c **** 
 416:Core/Src/vl53l1_api.c **** 		/* Round Cal Distance to Whole Number.
 417:Core/Src/vl53l1_api.c **** 		 * Note that the cal distance is in mm, therefore no resolution
 418:Core/Src/vl53l1_api.c **** 		 * is lost.
 419:Core/Src/vl53l1_api.c **** 		 */
 420:Core/Src/vl53l1_api.c **** 		 xTalkCalDistanceAsInt = ((uint32_t)BDTable[
 421:Core/Src/vl53l1_api.c **** 			VL53L1_TUNING_SINGLE_TARGET_XTALK_TARGET_DISTANCE_MM]);
 422:Core/Src/vl53l1_api.c **** 		if (xTalkStoredMeanRtnSpadsAsInt == 0 ||
 423:Core/Src/vl53l1_api.c **** 		xTalkCalDistanceAsInt == 0 ||
 424:Core/Src/vl53l1_api.c **** 		xTalkStoredMeanRange >= (xTalkCalDistanceAsInt << 16)) {
 425:Core/Src/vl53l1_api.c **** 			XTalkCompensationRateMegaCps = 0;
 426:Core/Src/vl53l1_api.c **** 		} else {
 427:Core/Src/vl53l1_api.c **** 			/* Apply division by mean spad count early in the
 428:Core/Src/vl53l1_api.c **** 			 * calculation to keep the numbers small.
 429:Core/Src/vl53l1_api.c **** 			 * This ensures we can maintain a 32bit calculation.
 430:Core/Src/vl53l1_api.c **** 			 * Fixed1616 / int := Fixed1616
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccE9MZbZ.s 			page 9


 431:Core/Src/vl53l1_api.c **** 			 */
 432:Core/Src/vl53l1_api.c **** 			signalXTalkTotalPerSpad = (xTalkStoredMeanSignalRate) /
 433:Core/Src/vl53l1_api.c **** 				xTalkStoredMeanRtnSpadsAsInt;
 434:Core/Src/vl53l1_api.c **** 
 435:Core/Src/vl53l1_api.c **** 			/* Complete the calculation for total Signal XTalk per
 436:Core/Src/vl53l1_api.c **** 			 * SPAD
 437:Core/Src/vl53l1_api.c **** 			 * Fixed1616 * (Fixed1616 - Fixed1616/int) :=
 438:Core/Src/vl53l1_api.c **** 			 * (2^16 * Fixed1616)
 439:Core/Src/vl53l1_api.c **** 			 */
 440:Core/Src/vl53l1_api.c **** 			signalXTalkTotalPerSpad *= (((uint32_t)1 << 16) -
 441:Core/Src/vl53l1_api.c **** 				(xTalkStoredMeanRange / xTalkCalDistanceAsInt));
 442:Core/Src/vl53l1_api.c **** 
 443:Core/Src/vl53l1_api.c **** 			/* Round from 2^16 * Fixed1616, to Fixed1616. */
 444:Core/Src/vl53l1_api.c **** 			XTalkCompensationRateMegaCps = (signalXTalkTotalPerSpad
 445:Core/Src/vl53l1_api.c **** 				+ 0x8000) >> 16;
 446:Core/Src/vl53l1_api.c **** 		}
 447:Core/Src/vl53l1_api.c **** 
 448:Core/Src/vl53l1_api.c **** 
 449:Core/Src/vl53l1_api.c **** 		Status = VL53L1_GetCalibrationData(Dev, &CalibrationData);
 450:Core/Src/vl53l1_api.c **** 
 451:Core/Src/vl53l1_api.c **** 		if (Status != VL53L1_ERROR_NONE)
 452:Core/Src/vl53l1_api.c **** 			goto ENDFUNC;
 453:Core/Src/vl53l1_api.c **** 
 454:Core/Src/vl53l1_api.c **** 		pC = &CalibrationData.customer;
 455:Core/Src/vl53l1_api.c **** 
 456:Core/Src/vl53l1_api.c **** 		pC->algo__crosstalk_compensation_plane_offset_kcps =
 457:Core/Src/vl53l1_api.c **** 			(uint32_t)(1000 * ((XTalkCompensationRateMegaCps  +
 458:Core/Src/vl53l1_api.c **** 				((uint32_t)1<<6)) >> (16-9)));
 459:Core/Src/vl53l1_api.c **** 
 460:Core/Src/vl53l1_api.c **** 		Status = VL53L1_SetCalibrationData(Dev, &CalibrationData);
 461:Core/Src/vl53l1_api.c **** 
 462:Core/Src/vl53l1_api.c **** 		if (Status != VL53L1_ERROR_NONE)
 463:Core/Src/vl53l1_api.c **** 			goto ENDFUNC;
 464:Core/Src/vl53l1_api.c **** 
 465:Core/Src/vl53l1_api.c **** 		Status = VL53L1_enable_xtalk_compensation(Dev);
 466:Core/Src/vl53l1_api.c **** 
 467:Core/Src/vl53l1_api.c **** 	} else
 468:Core/Src/vl53l1_api.c **** 		/* return error because no valid data found */
 469:Core/Src/vl53l1_api.c **** 		Status = VL53L1_ERROR_XTALK_EXTRACTION_NO_SAMPLE_FAIL;
 470:Core/Src/vl53l1_api.c **** 
 471:Core/Src/vl53l1_api.c **** ENDFUNC:
 472:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_END(Status);
 473:Core/Src/vl53l1_api.c **** 	return Status;
