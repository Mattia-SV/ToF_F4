1692:Core/Src/vl53l1_api.c **** VL53L1_Error VL53L1_StartMeasurement(VL53L1_DEV Dev)
1693:Core/Src/vl53l1_api.c **** {
1694:Core/Src/vl53l1_api.c **** #define TIMED_MODE_TIMING_GUARD_MILLISECONDS 4
1695:Core/Src/vl53l1_api.c **** 	VL53L1_Error Status = VL53L1_ERROR_NONE;
1696:Core/Src/vl53l1_api.c **** 	uint8_t DeviceMeasurementMode;
1697:Core/Src/vl53l1_api.c **** 	VL53L1_State CurrPalState;
1698:Core/Src/vl53l1_api.c **** 	VL53L1_Error lStatus;
1699:Core/Src/vl53l1_api.c **** 	uint32_t MTBus, IMPms;
1700:Core/Src/vl53l1_api.c **** 
1701:Core/Src/vl53l1_api.c **** 
1702:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_START("");
1703:Core/Src/vl53l1_api.c **** 
1704:Core/Src/vl53l1_api.c **** 	DeviceMeasurementMode = VL53L1DevDataGet(Dev, LLData.measurement_mode);
1705:Core/Src/vl53l1_api.c **** 	if (DeviceMeasurementMode != VL53L1_DEVICEMEASUREMENTMODE_TIMED)
1706:Core/Src/vl53l1_api.c **** 		VL53L1_LoadPatch(Dev);
1707:Core/Src/vl53l1_api.c **** 	CurrPalState = VL53L1DevDataGet(Dev, PalState);
1708:Core/Src/vl53l1_api.c **** 	switch (CurrPalState) {
1709:Core/Src/vl53l1_api.c **** 	case VL53L1_STATE_IDLE:
1710:Core/Src/vl53l1_api.c **** 		Status = VL53L1_ERROR_NONE;
1711:Core/Src/vl53l1_api.c **** 		break;
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccE9MZbZ.s 			page 38


1712:Core/Src/vl53l1_api.c **** 	case VL53L1_STATE_POWERDOWN:
1713:Core/Src/vl53l1_api.c **** 	case VL53L1_STATE_WAIT_STATICINIT:
1714:Core/Src/vl53l1_api.c **** 	case VL53L1_STATE_STANDBY:
1715:Core/Src/vl53l1_api.c **** 	case VL53L1_STATE_RUNNING:
1716:Core/Src/vl53l1_api.c **** 	case VL53L1_STATE_RESET:
1717:Core/Src/vl53l1_api.c **** 	case VL53L1_STATE_UNKNOWN:
1718:Core/Src/vl53l1_api.c **** 	case VL53L1_STATE_ERROR:
1719:Core/Src/vl53l1_api.c **** 		Status = VL53L1_ERROR_INVALID_COMMAND;
1720:Core/Src/vl53l1_api.c **** 		break;
1721:Core/Src/vl53l1_api.c **** 	default:
1722:Core/Src/vl53l1_api.c **** 		Status = VL53L1_ERROR_UNDEFINED;
1723:Core/Src/vl53l1_api.c **** 	}
1724:Core/Src/vl53l1_api.c **** 
1725:Core/Src/vl53l1_api.c **** 	/* Check timing configuration between timing budget and
1726:Core/Src/vl53l1_api.c **** 	 * inter measurement period */
1727:Core/Src/vl53l1_api.c **** 	if ((Status == VL53L1_ERROR_NONE) &&
1728:Core/Src/vl53l1_api.c **** 		(DeviceMeasurementMode == VL53L1_DEVICEMEASUREMENTMODE_TIMED)) {
1729:Core/Src/vl53l1_api.c **** 		lStatus = VL53L1_GetMeasurementTimingBudgetMicroSeconds(Dev,
1730:Core/Src/vl53l1_api.c **** 				&MTBus);
1731:Core/Src/vl53l1_api.c **** 		/* convert timing budget in ms */
1732:Core/Src/vl53l1_api.c **** 		MTBus /= 1000;
1733:Core/Src/vl53l1_api.c **** 		lStatus = VL53L1_GetInterMeasurementPeriodMilliSeconds(Dev,
1734:Core/Src/vl53l1_api.c **** 				&IMPms);
1735:Core/Src/vl53l1_api.c **** 		/* trick to get rid of compiler "set but not used" warning */
1736:Core/Src/vl53l1_api.c **** 		SUPPRESS_UNUSED_WARNING(lStatus);
1737:Core/Src/vl53l1_api.c **** 		if (IMPms < MTBus + TIMED_MODE_TIMING_GUARD_MILLISECONDS)
1738:Core/Src/vl53l1_api.c **** 			Status = VL53L1_ERROR_INVALID_PARAMS;
1739:Core/Src/vl53l1_api.c **** 	}
1740:Core/Src/vl53l1_api.c **** 
1741:Core/Src/vl53l1_api.c **** 	if (Status == VL53L1_ERROR_NONE)
1742:Core/Src/vl53l1_api.c **** 		Status = VL53L1_init_and_start_range(
1743:Core/Src/vl53l1_api.c **** 				Dev,
1744:Core/Src/vl53l1_api.c **** 				DeviceMeasurementMode,
1745:Core/Src/vl53l1_api.c **** 				VL53L1_DEVICECONFIGLEVEL_FULL);
1746:Core/Src/vl53l1_api.c **** 
1747:Core/Src/vl53l1_api.c **** 	/* Set PAL State to Running */
1748:Core/Src/vl53l1_api.c **** 	if (Status == VL53L1_ERROR_NONE)
1749:Core/Src/vl53l1_api.c **** 		VL53L1DevDataSet(Dev, PalState, VL53L1_STATE_RUNNING);
1750:Core/Src/vl53l1_api.c **** 
1751:Core/Src/vl53l1_api.c **** 
1752:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_END(Status);
1753:Core/Src/vl53l1_api.c **** 	return Status;
1754:Core/Src/vl53l1_api.c **** }
1755:Core/Src/vl53l1_api.c **** 
1756:Core/Src/vl53l1_api.c **** VL53L1_Error VL53L1_StopMeasurement(VL53L1_DEV Dev)
1757:Core/Src/vl53l1_api.c **** {
1758:Core/Src/vl53l1_api.c **** 	VL53L1_Error Status = VL53L1_ERROR_NONE;
1759:Core/Src/vl53l1_api.c **** 	uint8_t DeviceMeasurementMode;
