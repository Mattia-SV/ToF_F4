 321:Core/Src/vl53l1_api.c **** static VL53L1_Error SingleTargetXTalkCalibration(VL53L1_DEV Dev)
 322:Core/Src/vl53l1_api.c **** {
 323:Core/Src/vl53l1_api.c **** 	VL53L1_Error Status = VL53L1_ERROR_NONE;
 324:Core/Src/vl53l1_api.c **** 
 325:Core/Src/vl53l1_api.c **** 	uint32_t sum_ranging = 0;
 326:Core/Src/vl53l1_api.c **** 	uint32_t sum_spads = 0;
 327:Core/Src/vl53l1_api.c **** 	FixPoint1616_t sum_signalRate = 0;
 328:Core/Src/vl53l1_api.c **** 	FixPoint1616_t total_count = 0;
 329:Core/Src/vl53l1_api.c **** 	uint8_t xtalk_meas = 0;
 330:Core/Src/vl53l1_api.c **** 	uint8_t xtalk_measmax =
 331:Core/Src/vl53l1_api.c **** 		BDTable[VL53L1_TUNING_SINGLE_TARGET_XTALK_SAMPLE_NUMBER];
 332:Core/Src/vl53l1_api.c **** 	VL53L1_RangingMeasurementData_t RMData;
 333:Core/Src/vl53l1_api.c **** 	FixPoint1616_t xTalkStoredMeanSignalRate;
 334:Core/Src/vl53l1_api.c **** 	FixPoint1616_t xTalkStoredMeanRange;
 335:Core/Src/vl53l1_api.c **** 	FixPoint1616_t xTalkStoredMeanRtnSpads;
 336:Core/Src/vl53l1_api.c **** 	uint32_t xTalkStoredMeanRtnSpadsAsInt;
 337:Core/Src/vl53l1_api.c **** 	uint32_t xTalkCalDistanceAsInt;
 338:Core/Src/vl53l1_api.c **** 	FixPoint1616_t XTalkCompensationRateMegaCps;
 339:Core/Src/vl53l1_api.c **** 	uint32_t signalXTalkTotalPerSpad;
 340:Core/Src/vl53l1_api.c **** 	VL53L1_PresetModes PresetMode;
