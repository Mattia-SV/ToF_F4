1557:Core/Src/vl53l1_api.c **** VL53L1_Error VL53L1_SetUserROI(VL53L1_DEV Dev,
1558:Core/Src/vl53l1_api.c **** 		VL53L1_UserRoi_t *pRoi)
1559:Core/Src/vl53l1_api.c **** {
1560:Core/Src/vl53l1_api.c **** 	VL53L1_Error Status = VL53L1_ERROR_NONE;
1561:Core/Src/vl53l1_api.c **** 	VL53L1_user_zone_t user_zone;
1562:Core/Src/vl53l1_api.c **** 
1563:Core/Src/vl53l1_api.c **** 	Status = CheckValidRectRoi(*pRoi);
1564:Core/Src/vl53l1_api.c **** 	if (Status != VL53L1_ERROR_NONE)
1565:Core/Src/vl53l1_api.c **** 		return VL53L1_ERROR_INVALID_PARAMS;
1566:Core/Src/vl53l1_api.c **** 
1567:Core/Src/vl53l1_api.c **** 	user_zone.x_centre = (pRoi->BotRightX + pRoi->TopLeftX  + 1) / 2;
1568:Core/Src/vl53l1_api.c **** 	user_zone.y_centre = (pRoi->TopLeftY  + pRoi->BotRightY + 1) / 2;
1569:Core/Src/vl53l1_api.c **** 	user_zone.width =    (pRoi->BotRightX - pRoi->TopLeftX);
1570:Core/Src/vl53l1_api.c **** 	user_zone.height =   (pRoi->TopLeftY  - pRoi->BotRightY);
1571:Core/Src/vl53l1_api.c **** 	if ((user_zone.width < 3) || (user_zone.height < 3))
1572:Core/Src/vl53l1_api.c **** 		Status = VL53L1_ERROR_INVALID_PARAMS;
1573:Core/Src/vl53l1_api.c **** 	else
1574:Core/Src/vl53l1_api.c **** 		Status =  VL53L1_set_user_zone(Dev, &user_zone);
1575:Core/Src/vl53l1_api.c **** 
1576:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_END(Status);
1577:Core/Src/vl53l1_api.c **** 	return Status;
1578:Core/Src/vl53l1_api.c **** }
