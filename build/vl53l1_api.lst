1580:Core/Src/vl53l1_api.c **** VL53L1_Error VL53L1_GetUserROI(VL53L1_DEV Dev,
1581:Core/Src/vl53l1_api.c **** 		VL53L1_UserRoi_t *pRoi)
1582:Core/Src/vl53l1_api.c **** {
1583:Core/Src/vl53l1_api.c **** 	VL53L1_Error Status = VL53L1_ERROR_NONE;
1584:Core/Src/vl53l1_api.c **** 	VL53L1_user_zone_t	user_zone;
1585:Core/Src/vl53l1_api.c **** 
1586:Core/Src/vl53l1_api.c **** 	Status = VL53L1_get_user_zone(Dev, &user_zone);
1587:Core/Src/vl53l1_api.c **** 
1588:Core/Src/vl53l1_api.c **** 	pRoi->TopLeftX =  (2 * user_zone.x_centre - user_zone.width) >> 1;
1589:Core/Src/vl53l1_api.c **** 	pRoi->TopLeftY =  (2 * user_zone.y_centre + user_zone.height) >> 1;
1590:Core/Src/vl53l1_api.c **** 	pRoi->BotRightX = (2 * user_zone.x_centre + user_zone.width) >> 1;
1591:Core/Src/vl53l1_api.c **** 	pRoi->BotRightY = (2 * user_zone.y_centre - user_zone.height) >> 1;
1592:Core/Src/vl53l1_api.c **** 
1593:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_END(Status);
1594:Core/Src/vl53l1_api.c **** 	return Status;
1595:Core/Src/vl53l1_api.c **** }
