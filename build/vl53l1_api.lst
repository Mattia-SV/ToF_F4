 270:Core/Src/vl53l1_api.c **** 
 271:Core/Src/vl53l1_api.c **** static VL53L1_Error VL53L1_read_nvm_raw_data(
 272:Core/Src/vl53l1_api.c **** 	VL53L1_DEV     Dev,
 273:Core/Src/vl53l1_api.c **** 	uint8_t        start_address,
 274:Core/Src/vl53l1_api.c **** 	uint8_t        count,
 275:Core/Src/vl53l1_api.c **** 	uint8_t       *pnvm_raw_data)
 276:Core/Src/vl53l1_api.c **** {
 277:Core/Src/vl53l1_api.c **** 
 278:Core/Src/vl53l1_api.c **** 	/*
 279:Core/Src/vl53l1_api.c **** 	 * Reads ALL 512 bytes of NVM data
