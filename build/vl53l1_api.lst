 281:Core/Src/vl53l1_api.c **** 
 282:Core/Src/vl53l1_api.c **** 	VL53L1_Error status = VL53L1_ERROR_NONE;
 283:Core/Src/vl53l1_api.c **** 
 284:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_START("");
 285:Core/Src/vl53l1_api.c **** 
 286:Core/Src/vl53l1_api.c **** 	/*
 287:Core/Src/vl53l1_api.c **** 	 *   Enable NVM and set control pulse width
 288:Core/Src/vl53l1_api.c **** 	 */
 289:Core/Src/vl53l1_api.c **** 
 290:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE) /*lint !e774 always true*/
 291:Core/Src/vl53l1_api.c **** 		status = VL53L1_nvm_enable(
 292:Core/Src/vl53l1_api.c **** 					Dev,
 293:Core/Src/vl53l1_api.c **** 					0x0004,
 294:Core/Src/vl53l1_api.c **** 					VL53L1_NVM_POWER_UP_DELAY_US);
 295:Core/Src/vl53l1_api.c **** 
 296:Core/Src/vl53l1_api.c **** 	/*
 297:Core/Src/vl53l1_api.c **** 	 *  Read the raw NVM data
