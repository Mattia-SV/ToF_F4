  91:Core/Src/vl53l1_api.c **** static VL53L1_Error VL53L1_nvm_enable(
  92:Core/Src/vl53l1_api.c **** 	VL53L1_DEV      Dev,
  93:Core/Src/vl53l1_api.c **** 	uint16_t        nvm_ctrl_pulse_width,
  94:Core/Src/vl53l1_api.c **** 	int32_t         nvm_power_up_delay_us)
  95:Core/Src/vl53l1_api.c **** {
  96:Core/Src/vl53l1_api.c **** 	/*
  97:Core/Src/vl53l1_api.c **** 	 * Sequence below enables NVM for reading
  98:Core/Src/vl53l1_api.c **** 	 *
  99:Core/Src/vl53l1_api.c **** 	 *  - Enable power force
 100:Core/Src/vl53l1_api.c **** 	 *  - Disable firmware
 101:Core/Src/vl53l1_api.c **** 	 *  - Power up NVM
 102:Core/Src/vl53l1_api.c **** 	 *  - Wait for 50us while the NVM powers up
 103:Core/Src/vl53l1_api.c **** 	 *  - Configure for reading and set the pulse width (16-bit)
 104:Core/Src/vl53l1_api.c **** 	 */
 105:Core/Src/vl53l1_api.c **** 
 106:Core/Src/vl53l1_api.c **** 	VL53L1_Error status = VL53L1_ERROR_NONE;
 107:Core/Src/vl53l1_api.c **** 
 108:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_START("");
 109:Core/Src/vl53l1_api.c **** 
 110:Core/Src/vl53l1_api.c **** 
 111:Core/Src/vl53l1_api.c **** 	/* Disable Firmware */
 112:Core/Src/vl53l1_api.c **** 
 113:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE) /*lint !e774 always true*/
 114:Core/Src/vl53l1_api.c **** 		status = VL53L1_disable_firmware(Dev);
 115:Core/Src/vl53l1_api.c **** 
 116:Core/Src/vl53l1_api.c **** 
 117:Core/Src/vl53l1_api.c **** 	/* Enable Power Force  */
 118:Core/Src/vl53l1_api.c **** 
 119:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE)
 120:Core/Src/vl53l1_api.c **** 		status = VL53L1_enable_powerforce(Dev);
 121:Core/Src/vl53l1_api.c **** 
 122:Core/Src/vl53l1_api.c **** 	/* Wait the required time for the regulators, bandgap,
 123:Core/Src/vl53l1_api.c **** 	 * oscillator to wake up and settle
 124:Core/Src/vl53l1_api.c **** 	 */
 125:Core/Src/vl53l1_api.c **** 
 126:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE)
 127:Core/Src/vl53l1_api.c **** 		status = VL53L1_WaitUs(Dev,
 128:Core/Src/vl53l1_api.c **** 				VL53L1_ENABLE_POWERFORCE_SETTLING_TIME_US);
 129:Core/Src/vl53l1_api.c **** 
 130:Core/Src/vl53l1_api.c **** 	/*  Power up NVM */
 131:Core/Src/vl53l1_api.c **** 
 132:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE)
 133:Core/Src/vl53l1_api.c **** 		status = VL53L1_WrByte(Dev, VL53L1_RANGING_CORE__NVM_CTRL__PDN,
 134:Core/Src/vl53l1_api.c **** 				0x01);
 135:Core/Src/vl53l1_api.c **** 
 136:Core/Src/vl53l1_api.c **** 	/* Enable NVM Clock */
 137:Core/Src/vl53l1_api.c **** 
 138:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE)
 139:Core/Src/vl53l1_api.c **** 		status = VL53L1_WrByte(Dev, VL53L1_RANGING_CORE__CLK_CTRL1,
 140:Core/Src/vl53l1_api.c **** 				0x05);
 141:Core/Src/vl53l1_api.c **** 
 142:Core/Src/vl53l1_api.c **** 	/* Wait the required time for NVM to power up*/
 143:Core/Src/vl53l1_api.c **** 
 144:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE)
 145:Core/Src/vl53l1_api.c **** 		status = VL53L1_WaitUs(Dev, nvm_power_up_delay_us);
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccE9MZbZ.s 			page 4


 146:Core/Src/vl53l1_api.c **** 
 147:Core/Src/vl53l1_api.c **** 	/* Select read mode and set control pulse width */
 148:Core/Src/vl53l1_api.c **** 
 149:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE)
 150:Core/Src/vl53l1_api.c **** 		status = VL53L1_WrByte(Dev, VL53L1_RANGING_CORE__NVM_CTRL__MODE,
 151:Core/Src/vl53l1_api.c **** 				0x01);
 152:Core/Src/vl53l1_api.c **** 
 153:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE)
 154:Core/Src/vl53l1_api.c **** 		status = VL53L1_WrWord(Dev,
 155:Core/Src/vl53l1_api.c **** 				VL53L1_RANGING_CORE__NVM_CTRL__PULSE_WIDTH_MSB,
 156:Core/Src/vl53l1_api.c **** 				nvm_ctrl_pulse_width);
 157:Core/Src/vl53l1_api.c **** 
 158:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_END(status);
 159:Core/Src/vl53l1_api.c **** 
 160:Core/Src/vl53l1_api.c **** 	return status;
 161:Core/Src/vl53l1_api.c **** 
 162:Core/Src/vl53l1_api.c **** }
 163:Core/Src/vl53l1_api.c **** 
 164:Core/Src/vl53l1_api.c **** 
 165:Core/Src/vl53l1_api.c **** static VL53L1_Error VL53L1_nvm_read(
 166:Core/Src/vl53l1_api.c **** 	VL53L1_DEV    Dev,
 167:Core/Src/vl53l1_api.c **** 	uint8_t       start_address,
 168:Core/Src/vl53l1_api.c **** 	uint8_t       count,
 169:Core/Src/vl53l1_api.c **** 	uint8_t      *pdata)
 170:Core/Src/vl53l1_api.c **** {
 171:Core/Src/vl53l1_api.c **** 	/*
 172:Core/Src/vl53l1_api.c **** 	 * Sequence per 32-bit NVM read access:
 173:Core/Src/vl53l1_api.c **** 	 *
 174:Core/Src/vl53l1_api.c **** 	 * - Set up the 5-bit (0-127) NVM Address
 175:Core/Src/vl53l1_api.c **** 	 * - Trigger the read of the NVM data by toggling NVM_CTRL__READN
 176:Core/Src/vl53l1_api.c **** 	 * - Read the NVM data - 4 bytes wide read/write interface
 177:Core/Src/vl53l1_api.c **** 	 * - Increment data byte pointer by 4 ready for the next loop
 178:Core/Src/vl53l1_api.c **** 	 */
 179:Core/Src/vl53l1_api.c **** 
 180:Core/Src/vl53l1_api.c **** 	VL53L1_Error status   = VL53L1_ERROR_NONE;
 181:Core/Src/vl53l1_api.c **** 	uint8_t nvm_addr = 0;
 182:Core/Src/vl53l1_api.c **** 	uint8_t start = start_address;
 183:Core/Src/vl53l1_api.c **** 	uint8_t end   = start_address + count;
 184:Core/Src/vl53l1_api.c **** 
 185:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_START("");
 186:Core/Src/vl53l1_api.c **** 
 187:Core/Src/vl53l1_api.c **** 	for (nvm_addr = start; nvm_addr < end; nvm_addr++) {
 188:Core/Src/vl53l1_api.c **** 
 189:Core/Src/vl53l1_api.c **** 		/* Step 1 : set address */
 190:Core/Src/vl53l1_api.c **** 
 191:Core/Src/vl53l1_api.c **** 		if (status == VL53L1_ERROR_NONE)
 192:Core/Src/vl53l1_api.c **** 			status = VL53L1_WrByte(Dev,
 193:Core/Src/vl53l1_api.c **** 					VL53L1_RANGING_CORE__NVM_CTRL__ADDR,
 194:Core/Src/vl53l1_api.c **** 					nvm_addr);
 195:Core/Src/vl53l1_api.c **** 
 196:Core/Src/vl53l1_api.c **** 		/* Step 2 : trigger reading of data */
 197:Core/Src/vl53l1_api.c **** 
 198:Core/Src/vl53l1_api.c **** 		if (status == VL53L1_ERROR_NONE)
 199:Core/Src/vl53l1_api.c **** 			status = VL53L1_WrByte(Dev,
 200:Core/Src/vl53l1_api.c **** 					VL53L1_RANGING_CORE__NVM_CTRL__READN,
 201:Core/Src/vl53l1_api.c **** 					0x00);
 202:Core/Src/vl53l1_api.c **** 
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccE9MZbZ.s 			page 5


 203:Core/Src/vl53l1_api.c **** 		/* Step 3 : wait the required time */
 204:Core/Src/vl53l1_api.c **** 
 205:Core/Src/vl53l1_api.c **** 		if (status == VL53L1_ERROR_NONE)
 206:Core/Src/vl53l1_api.c **** 			status = VL53L1_WaitUs(Dev,
 207:Core/Src/vl53l1_api.c **** 					VL53L1_NVM_READ_TRIGGER_DELAY_US);
 208:Core/Src/vl53l1_api.c **** 
 209:Core/Src/vl53l1_api.c **** 		if (status == VL53L1_ERROR_NONE)
 210:Core/Src/vl53l1_api.c **** 			status = VL53L1_WrByte(Dev,
 211:Core/Src/vl53l1_api.c **** 					VL53L1_RANGING_CORE__NVM_CTRL__READN,
 212:Core/Src/vl53l1_api.c **** 					0x01);
 213:Core/Src/vl53l1_api.c **** 
 214:Core/Src/vl53l1_api.c **** 		/* Step 3 : read 4-byte wide data register */
 215:Core/Src/vl53l1_api.c **** 		if (status == VL53L1_ERROR_NONE)
 216:Core/Src/vl53l1_api.c **** 			status = VL53L1_ReadMulti(Dev,
 217:Core/Src/vl53l1_api.c **** 				VL53L1_RANGING_CORE__NVM_CTRL__DATAOUT_MMM,
 218:Core/Src/vl53l1_api.c **** 				pdata, 4);
 219:Core/Src/vl53l1_api.c **** 
 220:Core/Src/vl53l1_api.c **** 		/* Step 4 : increment byte buffer pointer */
 221:Core/Src/vl53l1_api.c **** 		pdata = pdata + 4;
 222:Core/Src/vl53l1_api.c **** 
 223:Core/Src/vl53l1_api.c **** 	}
 224:Core/Src/vl53l1_api.c **** 
 225:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_END(status);
 226:Core/Src/vl53l1_api.c **** 
 227:Core/Src/vl53l1_api.c **** 	return status;
 228:Core/Src/vl53l1_api.c **** }
 229:Core/Src/vl53l1_api.c **** 
 230:Core/Src/vl53l1_api.c **** static VL53L1_Error VL53L1_nvm_disable(
 231:Core/Src/vl53l1_api.c **** 	VL53L1_DEV    Dev)
 232:Core/Src/vl53l1_api.c **** {
 233:Core/Src/vl53l1_api.c **** 	/*
 234:Core/Src/vl53l1_api.c **** 	 * Power down NVM (OTP) to extend lifetime
 235:Core/Src/vl53l1_api.c **** 	 */
 236:Core/Src/vl53l1_api.c **** 
 237:Core/Src/vl53l1_api.c **** 	VL53L1_Error status = VL53L1_ERROR_NONE;
 238:Core/Src/vl53l1_api.c **** 
 239:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_START("");
 240:Core/Src/vl53l1_api.c **** 
 241:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE) /*lint !e774 always true*/
 242:Core/Src/vl53l1_api.c **** 		status = VL53L1_WrByte(
 243:Core/Src/vl53l1_api.c **** 					Dev,
 244:Core/Src/vl53l1_api.c **** 					VL53L1_RANGING_CORE__NVM_CTRL__READN,
 245:Core/Src/vl53l1_api.c **** 					0x01);
 246:Core/Src/vl53l1_api.c **** 
 247:Core/Src/vl53l1_api.c **** 	/* Power down NVM */
 248:Core/Src/vl53l1_api.c **** 
 249:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE)
 250:Core/Src/vl53l1_api.c **** 		status = VL53L1_WrByte(
 251:Core/Src/vl53l1_api.c **** 					Dev,
 252:Core/Src/vl53l1_api.c **** 					VL53L1_RANGING_CORE__NVM_CTRL__PDN,
 253:Core/Src/vl53l1_api.c **** 					0x00);
 254:Core/Src/vl53l1_api.c **** 
 255:Core/Src/vl53l1_api.c **** 	/* Keep power force enabled */
 256:Core/Src/vl53l1_api.c **** 
 257:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE)
 258:Core/Src/vl53l1_api.c **** 		status = VL53L1_disable_powerforce(Dev);
 259:Core/Src/vl53l1_api.c **** 
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccE9MZbZ.s 			page 6


 260:Core/Src/vl53l1_api.c **** 	/* (Re)Enable Firmware */
 261:Core/Src/vl53l1_api.c **** 
 262:Core/Src/vl53l1_api.c **** 	if (status == VL53L1_ERROR_NONE)
 263:Core/Src/vl53l1_api.c **** 		status = VL53L1_enable_firmware(Dev);
 264:Core/Src/vl53l1_api.c **** 
 265:Core/Src/vl53l1_api.c **** 	LOG_FUNCTION_END(status);
 266:Core/Src/vl53l1_api.c **** 
 267:Core/Src/vl53l1_api.c **** 	return status;
 268:Core/Src/vl53l1_api.c **** 
