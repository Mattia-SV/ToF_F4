  88:Core/Src/vl53l1_wait.c **** VL53L1_Error VL53L1_wait_for_boot_completion(
  89:Core/Src/vl53l1_wait.c **** 	VL53L1_DEV     Dev)
  90:Core/Src/vl53l1_wait.c **** {
  91:Core/Src/vl53l1_wait.c **** 
  92:Core/Src/vl53l1_wait.c **** 	/* Waits for firmware boot to finish
  93:Core/Src/vl53l1_wait.c **** 	 */
  94:Core/Src/vl53l1_wait.c **** 
  95:Core/Src/vl53l1_wait.c **** 	VL53L1_Error status = VL53L1_ERROR_NONE;
  96:Core/Src/vl53l1_wait.c **** 	VL53L1_LLDriverData_t *pdev = VL53L1DevStructGetLLDriverHandle(Dev);
  97:Core/Src/vl53l1_wait.c **** 
  98:Core/Src/vl53l1_wait.c **** 	uint8_t      fw_ready  = 0;
  99:Core/Src/vl53l1_wait.c **** 
 100:Core/Src/vl53l1_wait.c **** 	LOG_FUNCTION_START("");
 101:Core/Src/vl53l1_wait.c **** 
 102:Core/Src/vl53l1_wait.c **** 	if (pdev->wait_method == VL53L1_WAIT_METHOD_BLOCKING) {
 103:Core/Src/vl53l1_wait.c **** 
 104:Core/Src/vl53l1_wait.c **** 		/* blocking version */
 105:Core/Src/vl53l1_wait.c **** 
 106:Core/Src/vl53l1_wait.c **** 		status =
 107:Core/Src/vl53l1_wait.c **** 			VL53L1_poll_for_boot_completion(
 108:Core/Src/vl53l1_wait.c **** 				Dev,
 109:Core/Src/vl53l1_wait.c **** 				VL53L1_BOOT_COMPLETION_POLLING_TIMEOUT_MS);
 110:Core/Src/vl53l1_wait.c **** 
 111:Core/Src/vl53l1_wait.c **** 	} else {
 112:Core/Src/vl53l1_wait.c **** 
 113:Core/Src/vl53l1_wait.c **** 		/* implement non blocking version below */
 114:Core/Src/vl53l1_wait.c **** 
 115:Core/Src/vl53l1_wait.c **** 		fw_ready = 0;
 116:Core/Src/vl53l1_wait.c **** 		while (fw_ready == 0x00 && status == VL53L1_ERROR_NONE) {
 117:Core/Src/vl53l1_wait.c **** 			status = VL53L1_is_boot_complete(
 118:Core/Src/vl53l1_wait.c **** 				Dev,
 119:Core/Src/vl53l1_wait.c **** 				&fw_ready);
 120:Core/Src/vl53l1_wait.c **** 
 121:Core/Src/vl53l1_wait.c **** 			if (status == VL53L1_ERROR_NONE) {
 122:Core/Src/vl53l1_wait.c **** 				status = VL53L1_WaitMs(
 123:Core/Src/vl53l1_wait.c **** 					Dev,
 124:Core/Src/vl53l1_wait.c **** 					VL53L1_POLLING_DELAY_MS);
 125:Core/Src/vl53l1_wait.c **** 			}
 126:Core/Src/vl53l1_wait.c **** 		}
 127:Core/Src/vl53l1_wait.c **** 	}
 128:Core/Src/vl53l1_wait.c **** 
 129:Core/Src/vl53l1_wait.c **** 	LOG_FUNCTION_END(status);
 130:Core/Src/vl53l1_wait.c **** 
 131:Core/Src/vl53l1_wait.c **** 	return status;
 132:Core/Src/vl53l1_wait.c **** 
 133:Core/Src/vl53l1_wait.c **** }
 134:Core/Src/vl53l1_wait.c **** 
 135:Core/Src/vl53l1_wait.c **** 
 136:Core/Src/vl53l1_wait.c **** VL53L1_Error VL53L1_wait_for_firmware_ready(
 137:Core/Src/vl53l1_wait.c **** 	VL53L1_DEV     Dev)
 138:Core/Src/vl53l1_wait.c **** {
 139:Core/Src/vl53l1_wait.c **** 
 140:Core/Src/vl53l1_wait.c **** 	/* If in timed mode or single shot then check firmware is ready
 141:Core/Src/vl53l1_wait.c **** 	 * before sending handshake
 142:Core/Src/vl53l1_wait.c **** 	 */
 143:Core/Src/vl53l1_wait.c **** 
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cchrMlZA.s 			page 4


 144:Core/Src/vl53l1_wait.c **** 	VL53L1_Error status = VL53L1_ERROR_NONE;
 145:Core/Src/vl53l1_wait.c **** 	VL53L1_LLDriverData_t *pdev = VL53L1DevStructGetLLDriverHandle(Dev);
 146:Core/Src/vl53l1_wait.c **** 
 147:Core/Src/vl53l1_wait.c **** 	uint8_t      fw_ready  = 0;
 148:Core/Src/vl53l1_wait.c **** 	uint8_t      mode_start  = 0;
 149:Core/Src/vl53l1_wait.c **** 
 150:Core/Src/vl53l1_wait.c **** 	LOG_FUNCTION_START("");
 151:Core/Src/vl53l1_wait.c **** 
 152:Core/Src/vl53l1_wait.c **** 	/* Filter out tje measure mode part of the mode
 153:Core/Src/vl53l1_wait.c **** 	 * start register
 154:Core/Src/vl53l1_wait.c **** 	 */
 155:Core/Src/vl53l1_wait.c **** 	mode_start =
 156:Core/Src/vl53l1_wait.c **** 		pdev->sys_ctrl.system__mode_start &
 157:Core/Src/vl53l1_wait.c **** 		VL53L1_DEVICEMEASUREMENTMODE_MODE_MASK;
 158:Core/Src/vl53l1_wait.c **** 
 159:Core/Src/vl53l1_wait.c **** 	/*
 160:Core/Src/vl53l1_wait.c **** 	 * conditional wait for firmware ready
 161:Core/Src/vl53l1_wait.c **** 	 * only waits for timed and single shot modes
 162:Core/Src/vl53l1_wait.c **** 	 */
 163:Core/Src/vl53l1_wait.c **** 
 164:Core/Src/vl53l1_wait.c **** 	if ((mode_start == VL53L1_DEVICEMEASUREMENTMODE_TIMED) ||
 165:Core/Src/vl53l1_wait.c **** 		(mode_start == VL53L1_DEVICEMEASUREMENTMODE_SINGLESHOT)) {
 166:Core/Src/vl53l1_wait.c **** 
 167:Core/Src/vl53l1_wait.c **** 		if (pdev->wait_method == VL53L1_WAIT_METHOD_BLOCKING) {
 168:Core/Src/vl53l1_wait.c **** 
 169:Core/Src/vl53l1_wait.c **** 			/* blocking version */
 170:Core/Src/vl53l1_wait.c **** 
 171:Core/Src/vl53l1_wait.c **** 			status =
 172:Core/Src/vl53l1_wait.c **** 				VL53L1_poll_for_firmware_ready(
 173:Core/Src/vl53l1_wait.c **** 					Dev,
 174:Core/Src/vl53l1_wait.c **** 					VL53L1_RANGE_COMPLETION_POLLING_TIMEOUT_MS);
 175:Core/Src/vl53l1_wait.c **** 
 176:Core/Src/vl53l1_wait.c **** 		} else {
 177:Core/Src/vl53l1_wait.c **** 
 178:Core/Src/vl53l1_wait.c **** 			/* implement non blocking version below */
 179:Core/Src/vl53l1_wait.c **** 
 180:Core/Src/vl53l1_wait.c **** 			fw_ready = 0;
 181:Core/Src/vl53l1_wait.c **** 			while (fw_ready == 0x00 && status == VL53L1_ERROR_NONE) {
 182:Core/Src/vl53l1_wait.c **** 				status = VL53L1_is_firmware_ready(
 183:Core/Src/vl53l1_wait.c **** 					Dev,
 184:Core/Src/vl53l1_wait.c **** 					&fw_ready);
 185:Core/Src/vl53l1_wait.c **** 
 186:Core/Src/vl53l1_wait.c **** 				if (status == VL53L1_ERROR_NONE) {
 187:Core/Src/vl53l1_wait.c **** 					status = VL53L1_WaitMs(
 188:Core/Src/vl53l1_wait.c **** 						Dev,
 189:Core/Src/vl53l1_wait.c **** 						VL53L1_POLLING_DELAY_MS);
 190:Core/Src/vl53l1_wait.c **** 				}
 191:Core/Src/vl53l1_wait.c **** 			}
 192:Core/Src/vl53l1_wait.c **** 		}
 193:Core/Src/vl53l1_wait.c **** 	}
 194:Core/Src/vl53l1_wait.c **** 
 195:Core/Src/vl53l1_wait.c **** 	LOG_FUNCTION_END(status);
 196:Core/Src/vl53l1_wait.c **** 
 197:Core/Src/vl53l1_wait.c **** 	return status;
 198:Core/Src/vl53l1_wait.c **** }
