 105:Core/Src/main.c **** Dev->comms_type        = 1;       // I2C
 106:Core/Src/main.c **** Dev->comms_speed_khz   = 400;
 107:Core/Src/main.c **** 
 108:Core/Src/main.c **** int status;
 109:Core/Src/main.c **** 
 110:Core/Src/main.c **** 
 111:Core/Src/main.c **** // Initialize the VL53L1X sensor
 112:Core/Src/main.c **** 
 113:Core/Src/main.c **** status = VL53L1_DataInit(Dev);
 114:Core/Src/main.c **** status = VL53L1_StaticInit(Dev);
 115:Core/Src/main.c **** status = VL53L1_SetDistanceMode(Dev, VL53L1_DISTANCEMODE_SHORT);
 116:Core/Src/main.c **** status = VL53L1_SetMeasurementTimingBudgetMicroSeconds(Dev, 33000);
 117:Core/Src/main.c **** status = VL53L1_SetInterMeasurementPeriodMilliSeconds(Dev, 100);
 118:Core/Src/main.c **** status = VL53L1_StartMeasurement(Dev);
 119:Core/Src/main.c **** char Payload[50];
 120:Core/Src/main.c ****   /* USER CODE END 2 */
 121:Core/Src/main.c **** 
 122:Core/Src/main.c ****   /* Infinite loop */
 123:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 124:Core/Src/main.c **** while (1)
 125:Core/Src/main.c **** {
 126:Core/Src/main.c ****     VL53L1_RangingMeasurementData_t RangingData;
 127:Core/Src/main.c ****     uint8_t dataReady = 0;
 128:Core/Src/main.c **** 
 129:Core/Src/main.c ****     status = VL53L1_GetMeasurementDataReady(Dev, &dataReady);
 130:Core/Src/main.c **** 
 131:Core/Src/main.c ****     if (status != VL53L1_ERROR_NONE) {
 132:Core/Src/main.c ****         sprintf(Payload, "GetReady error=%d\r\n", status);
 133:Core/Src/main.c ****         HAL_UART_Transmit(&huart2, (uint8_t*)Payload, strlen(Payload), 0xFFFF);
 134:Core/Src/main.c ****         HAL_Delay(100);
 135:Core/Src/main.c ****         continue;
 136:Core/Src/main.c ****     }
 137:Core/Src/main.c **** 
 138:Core/Src/main.c ****     if (dataReady == 0) {
 139:Core/Src/main.c ****         HAL_Delay(5);
 140:Core/Src/main.c ****         continue;
 141:Core/Src/main.c ****     }
 142:Core/Src/main.c **** 
 143:Core/Src/main.c ****     status = VL53L1_GetRangingMeasurementData(Dev, &RangingData);
 144:Core/Src/main.c ****     if (status == VL53L1_ERROR_NONE) {
 145:Core/Src/main.c ****         uint16_t distanza_mm = RangingData.RangeMilliMeter;
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cc6h8Y0z.s 			page 4


 146:Core/Src/main.c ****         sprintf(Payload, "Dist: %u mm\r\n", distanza_mm);
 147:Core/Src/main.c ****         HAL_UART_Transmit(&huart2, (uint8_t*)Payload, strlen(Payload), 0xFFFF);
 148:Core/Src/main.c ****     } else {
 149:Core/Src/main.c ****         sprintf(Payload, "GetData error =%d\r\n", status);
 150:Core/Src/main.c ****         HAL_UART_Transmit(&huart2, (uint8_t*)Payload, strlen(Payload), 0xFFFF);
 151:Core/Src/main.c ****     }
 152:Core/Src/main.c **** 
